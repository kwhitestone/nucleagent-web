# nucleagent-web 主壳应用本地开发环境变量
# 复制为 .env.local 后按需修改。
#
# Vite 只把 VITE_ 前缀的变量注入 import.meta.env（见 src/config.ts 的 env()）。
# 因此注入主壳时请加 VITE_ 前缀。

# 主壳 dev 端口（默认 26600，生产 80）
WEB_PORT=26600

# 三个子应用来源（micro-app 沙箱加载）
VITE_CORE_WEB_URL=http://localhost:26688
VITE_AUTH_WEB_URL=http://localhost:26678
VITE_EXECUTOR_WEB_URL=http://localhost:26698

# auth 后端地址——主壳直连它发登录请求（登录弹窗是壳的 chrome）。
# 其余业务数据由 core 子应用负责，壳不直连。
VITE_AUTH_BACKEND_URL=http://localhost:26670
